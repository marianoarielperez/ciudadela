# Dependencias y build
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.next/
out/
dist/
/build
/coverage

# Entorno y secretos
.env
.env*
.env*.local
.env.production
!.env.example

# Archivos subidos por usuarios (DNIs, facturas) y recibos
uploads/
recibos/

# Sistema
.DS_Store
Thumbs.db
# Archivos de bloqueo de Office (ej. datos/~$padron_socios.xlsx)
~$*
*.log
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Editor
.vscode/
.idea/
.superpowers/
# Config local de la herramienta: `launch.json` describe el dev server de ESTA
# máquina, no del proyecto. Se ignora sólo ese archivo, no `.claude/` entero:
# `settings.json` (permisos, hooks) sí es config de proyecto y tiene que poder
# commitearse el día que la agreguemos.
.claude/launch.json
# Permisos por máquina que Claude Code escribe solo; `settings.json` (config
# del proyecto, compartida) SÍ se commitea.
.claude/settings.local.json

# Next.js / TypeScript
*.tsbuildinfo
next-env.d.ts

# Vercel
.vercel

/src/generated/prisma

# Reporte generado por scripts/import-padron.ts
padron-import-report.txt
