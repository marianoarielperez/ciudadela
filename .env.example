# Copiar a `.env` y completar. NUNCA commitear el `.env` real.

# --- Base de datos (Módulo 0) ---
DATABASE_URL="mysql://sigev:***@localhost:3306/sigev"
# Shadow DB para `prisma migrate dev` (solo desarrollo).
# El usuario sigev no puede crear bases, por eso se usa root.
# `docker/mariadb-init/01-shadow-db.sql` la crea sola en volúmenes nuevos:
SHADOW_DATABASE_URL="mysql://root:***@localhost:3306/sigev_shadow"

# Solo para `npm run test:integration` (numeración de recibos contra MariaDB
# real). La base de desarrollo ya migrada sirve; el test usa el año 1999.
# DATABASE_URL_TEST="mysql://sigev:sigev_dev@localhost:3306/sigev"

# --- Auth.js (Módulo 0) ---
AUTH_SECRET=***
# AUTH_URL es además la base de todo el SEO (sitemap, robots.txt, canonical) y
# se HORNEA en el build: si falta o quedó en localhost, `npm run build` falla a
# propósito en vez de publicar el sitio apuntando a localhost.
AUTH_URL=https://vecinalciudadela.ar       # único entorno desplegado (staging dado de baja 20/08/2026)
# Sólo en la máquina de desarrollo: habilita `npm run build` con AUTH_URL en
# localhost (para probar un build de producción en local). Va COMENTADA acá a
# propósito — si se copia este archivo al VPS, la guarda tiene que seguir viva.
# ALLOW_LOCALHOST_BASE_URL=1

# --- Seed inicial (Módulo 0) ---
SEED_SUPERADMIN_PASSWORD=***
# Cuentas de prueba (admin.prueba@sigev.local / socio.prueba@sigev.local, con
# contraseña conocida y una de ellas ADMIN): opt-in EXPLÍCITO, sólo en la
# máquina de desarrollo. Sin esta variable no se crean, pase lo que pase con
# NODE_ENV — el seed corre en cada despliegue y ahí NODE_ENV no está definida.
# En el VPS esta línea NO debe existir. Ver `prisma/seed-guard.ts`.
# SEED_ALLOW_TEST_USERS="true"
SEED_TEST_PASSWORD=***
# Compatibilidad hacia atrás: la variable vieja ya NO alcanza para crearlas,
# sólo sirve como apagado explícito ("false" gana sobre el opt-in de arriba).
SEED_TEST_USERS="false"

# --- Mercado Pago (Módulo 3) ---
# PRODUCTIVAS desde el 22/08/2026 (piloto real del socio 306). Sandbox sólo en
# local: un cobro de prueba contra el dominio es plata de un vecino.
MP_ACCESS_TOKEN=***                        # producción desde el 22/08/2026
MP_WEBHOOK_SECRET=***                      # para validar x-Signature

# --- Email transaccional Brevo (Módulo 1) ---
# Sin BREVO_SMTP_HOST/USER/KEY + MAIL_FROM el sistema NO envía: cae al
# transporte de consola (deliberado, para que dev no se bloquee ni mande mails).
# La dirección de MAIL_FROM tiene que estar verificada como remitente en Brevo
# (Senders & IP > Senders), o Brevo rechaza el envío.
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=***
BREVO_SMTP_KEY=***
MAIL_FROM="Vecinal Ciudadela <notificaciones@vecinalciudadela.ar>"

# Guarda de pruebas (Módulo 3): casillas separadas por coma. Si está definida,
# ningún email sale hacia otra dirección — la guarda está en el TRANSPORTE, así
# que cubre wizard, panel y cron por igual. En producción NO definirla (borrarla
# es un paso del checklist de lanzamiento de docs/07).
EMAIL_ALLOWLIST=

# Tope de correos por corrida de cron o por lote del panel (Módulo 4C). Lo que
# excede queda para la corrida siguiente y el summary lo dice (`deferred: N`).
# Sin definir, 50. Un 0 o una basura caen al default: un tope de cero apagaría
# todos los avisos en silencio.
MAIL_BATCH_CAP=

# --- Archivos subidos: DNIs, facturas (Módulo 3) ---
UPLOADS_DIR=/var/sigev/uploads             # dev: ./uploads (gitignored)

# --- Recibos PDF (Módulo 4) ---
# Fuera del webroot y del repo, como los subidos: se sirven solo por ruta
# autenticada. Si no se define, cae a ./recibos (gitignored).
RECEIPTS_DIR=/var/sigev/recibos            # dev: ./recibos (gitignored)

# --- Cloudflare Turnstile, formularios públicos (Módulo 3) ---
# Turnstile: la site key es pública y la lee el cliente (NEXT_PUBLIC_).
# En dev usar las claves dummy de Cloudflare que siempre pasan:
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=***
TURNSTILE_SECRET_KEY=***

# --- Crons (Módulo 3: solicitudes; Módulo 4: tesorería y conciliación) ---
# Ya en uso: POST /api/cron/applications lo exige (sin él, el endpoint responde 503).
CRON_SECRET=***                            # protege endpoints internos de cron
